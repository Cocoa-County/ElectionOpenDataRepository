{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocoa-county.github.io/ElectionOpenDataRepository/schemas/elections.index.schema.json",
  "title": "Election Index",
  "description": "Schema for elections.index.json. Defines a tool-agnostic entry point for election result and precinct GIS artifacts.",
  "type": "object",
  "required": [
    "version",
    "updated",
    "elections"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Index format version."
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Date this index was last updated."
    },
    "defaultElectionId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional default election identifier for clients that need an initial selection."
    },
    "elections": {
      "type": "array",
      "minItems": 1,
      "description": "Election entries available to consumers.",
      "items": {
        "$ref": "#/$defs/electionEntry"
      }
    }
  },
  "$defs": {
    "urlOrPath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute URL or relative path resolved from elections.index.json."
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "dataUrl",
        "precinctsUrl"
      ],
      "description": "Optional historical or alternate version entry for a specific election payload.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotTypes": {
          "type": "array",
          "description": "Optional publisher-defined tags describing snapshot role.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "resultsTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string"
        },
        "county": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "grouped": {
          "type": "boolean"
        },
        "dataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "precinctsUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "metadataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "precinctIdField": {
          "type": "string",
          "minLength": 1
        },
        "precinctLabelField": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "electionEntry": {
      "type": "object",
      "required": [
        "id",
        "label",
        "dataUrl",
        "precinctsUrl",
        "precinctIdField",
        "precinctLabelField"
      ],
      "description": "Core election entry. Required fields are sufficient for tool-agnostic consumers.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique election entry identifier."
        },
        "electionGroupId": {
          "type": "string",
          "minLength": 1
        },
        "electionId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable election label."
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string"
        },
        "county": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "grouped": {
          "type": "boolean"
        },
        "dataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "precinctsUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "metadataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "precinctIdField": {
          "type": "string",
          "minLength": 1,
          "description": "GeoJSON property name that identifies precincts and maps to results keys."
        },
        "precinctLabelField": {
          "type": "string",
          "minLength": 1,
          "description": "GeoJSON property name used as human-readable precinct label."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "snapshots": {
          "type": "array",
          "description": "Optional list of versioned election snapshots.",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}