{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocoa-county.github.io/ElectionOpenDataRepository/schemas/elections.index.schema.json",
  "title": "Election Index",
  "x-schema-version": "2026-07-12",
  "description": "Schema for elections.index.json. Defines a tool-agnostic entry point for election result and geography GIS artifacts.",
  "type": "object",
  "required": [
    "version",
    "updated",
    "elections"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Index format version."
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Date this index was last updated."
    },
    "defaultElectionId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional default election identifier for clients that need an initial selection."
    },
    "elections": {
      "type": "array",
      "minItems": 1,
      "description": "Election entries available to consumers.",
      "items": {
        "$ref": "#/$defs/electionEntry"
      }
    }
  },
  "$defs": {
    "urlOrPath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute URL or relative path resolved from elections.index.json."
    },
    "layerView": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "dataUrl",
        "gisUrl",
        "joinField"
      ],
      "description": "A layer-specific map view with one results artifact and one GIS artifact joined by a declared field.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Layer identifier unique within a snapshot, such as precincts, places, or supervisor_districts. Do not include election or snapshot prefixes."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Geography type for this view, such as precinct, place, city, or supervisor_district."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable layer label."
        },
        "description": {
          "type": "string"
        },
        "dataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "gisUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "metadataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "joinField": {
          "type": "string",
          "minLength": 1,
          "description": "Feature property name used to join GIS features to per-area results keys."
        },
        "labelField": {
          "type": "string",
          "minLength": 1,
          "description": "Feature property name used as the preferred human-readable area label."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "layers"
      ],
      "description": "Optional historical or alternate version entry for a specific election payload. Snapshots are layers-only. Legacy area fields are unsupported. Snapshot layers do not inherit from parent election layers.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Snapshot identifier unique within its election. Use concise values like final or timestamp tokens, without election id prefixes."
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotTypes": {
          "type": "array",
          "description": "Optional publisher-defined tags describing snapshot role.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "resultsTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string"
        },
        "county": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "grouped": {
          "type": "boolean"
        },
        "metadataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "description": "Layer-specific artifacts for this snapshot. These layers fully define snapshot map views and replace parent election layers for this snapshot.",
          "items": {
            "$ref": "#/$defs/layerView"
          }
        }
      },
      "additionalProperties": true
    },
    "electionEntry": {
      "type": "object",
      "required": [
        "id",
        "label",
        "snapshots"
      ],
      "description": "Core election entry. Snapshots are required and represent versioned time-based map states for this election.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique election entry identifier. Recommended format: {state-abbr}-{county-or-jurisdiction}-{yyyy-mm-dd}-{election-type}."
        },
        "electionId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable election label."
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string"
        },
        "county": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "grouped": {
          "type": "boolean"
        },
        "metadataUrl": {
          "$ref": "#/$defs/urlOrPath"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "snapshots": {
          "type": "array",
          "minItems": 1,
          "description": "Optional list of versioned election snapshots. Snapshot layer sets may differ by timestamp.",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}