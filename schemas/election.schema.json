{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocoa-county.github.io/ElectionOpenDataRepository/schemas/election.schema.json",
  "title": "Election Results Data",
  "x-schema-version": "2026-07-12",
  "description": "Schema for election results files. Uses generalized area-keyed results.",
  "type": "object",
  "required": [
    "contests"
  ],
  "properties": {
    "geography": {
      "$ref": "#/$defs/geographyDescriptor"
    },
    "contests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contest"
      }
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "required": [
        "index",
        "id",
        "label",
        "votes"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "party": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "votes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "winner": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "geographyDescriptor": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "joinField"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "joinField": {
          "type": "string",
          "minLength": 1
        },
        "labelField": {
          "type": "string"
        },
        "gisUrl": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "areaResult": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "winner": {
          "$ref": "#/$defs/winner"
        },
        "results": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "percentage": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "registeredVoters": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalVoters": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "contest": {
      "type": "object",
      "required": [
        "index",
        "id",
        "label",
        "choices",
        "areas"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "voteFor": {
          "type": "integer",
          "minimum": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "areas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/areaResult"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}